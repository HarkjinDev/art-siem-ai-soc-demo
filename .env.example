# No real credentials in this file. Run setup.ps1 or copy to .env.
SOC_PORT=8088
# AI OFF by default. To enable set the URL below AND run compose --profile ai up.
DOCKER_AGENT_URL=
DOCKER_AGENT_TOKEN=
GOOGLE_API_KEY=
# Slack incoming webhook is optional (alerts only, no interactive buttons)
SLACK_WEBHOOK_URL=
# Import from running Wazuh Indexer is optional; set all below to enable.
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_CA_FILE=/app/certs/root-ca.pem

# Optional interactive Slack Socket Mode (run --profile slack).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# Optional notification-only webhook remains supported; Slack Bot posts independently.

# Optional: comma-separated Slack USER IDs permitted to approve/reject drafts (not deployment)
SLACK_APPROVER_IDS=
SLACK_POLL_SECONDS=10

# Wazuh fresh installation (fill locally; never commit .env)
WAZUH_KIBANA_PASSWORD=
WAZUH_API_PASSWORD=
WAZUH_DASHBOARD_PORT=8443
# Use 0.0.0.0 only if remote Wazuh agents must connect and firewall is configured
WAZUH_BIND_IP=127.0.0.1

# v5.x defaults: start with manual import; enable after verifying real Wazuh events
WAZUH_AUTO_IMPORT=false
WAZUH_POLL_SECONDS=120
WAZUH_POLL_BATCH=5
WAZUH_INITIAL_LOOKBACK_MINUTES=15
WAZUH_AI_PER_POLL=2
SOC_CONTEXT_MAX_CHARS=2400
